# Storage backend: "local" (JSON files in .local-data/) or "gcp" (Cloud Firestore + GCS)
STORAGE_BACKEND=local
GOOGLE_CLOUD_PROJECT=
GCS_BUCKET_NAME=

# Google AI Gemini (from Secret Manager on Cloud Run)
GEMINI_API_KEY=
GEMINI_PRIMARY_MODEL=gemini-2.5-flash
GEMINI_LITE_MODEL=gemini-2.5-flash-lite
ALLOW_LOCAL_AI_FALLBACK=true

# Optional Google Cloud Neural Text-to-Speech
GCP_TTS_ENABLED=false
GCP_TTS_VOICE=en-US-Neural2-D

# Optional Firebase Google Sign-In Lockdown (default false = open access)
AUTH_REQUIRED=false
ALLOWED_EMAILS=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
